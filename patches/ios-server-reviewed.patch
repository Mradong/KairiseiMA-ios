+package cnbootstrap
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// Text-only fixtures exercise the C# ContentManifest.Parse contract. They are
+// not Unity AssetBundles and establish no device/resource completeness claim.
+func TestIOSManifestClientContract(t *testing.T) {
+	for _, scenario := range []string{"valid", "wrong-content-id", "duplicate-dependency", "cycle", "invalid-name", "oversized-bundle"} {
+		t.Run(scenario, func(t *testing.T) {
+			wire := platformClientManifest{Format: 1, Platform: "iOS", UnityVersion: "6000.3.26f1", Bundles: []platformClientBundle{
+				{Name: "recovery/ui.dat", File: strings.Repeat("b", 64) + ".bundle", Bytes: 34, SHA256: strings.Repeat("b", 64), CRC32: "ABCDEF01", Dependencies: []string{"recovery/base.dat"}},
+				{Name: "recovery/base.dat", File: strings.Repeat("a", 64) + ".bundle", Bytes: 12, SHA256: strings.Repeat("a", 64), CRC32: "12345678", Dependencies: []string{}},
+			}}
+			switch scenario {
+			case "duplicate-dependency":
+				wire.Bundles[0].Dependencies = []string{"recovery/base.dat", "recovery/base.dat"}
+			case "cycle":
+				wire.Bundles[1].Dependencies = []string{"recovery/ui.dat"}
+			case "invalid-name":
+				wire.Bundles[0].Name = "Recovery/UI.dat"
+			case "oversized-bundle":
+				wire.Bundles[0].Bytes = 512<<20 + 1
+			}
+			// Independent serialization of the client's canonical input. In the
+			// valid fixture base.dat sorts before ui.dat regardless of wire order.
+			canonical := "iOS\n6000.3.26f1\n"
+			for _, i := range []int{1, 0} {
+				row := wire.Bundles[i]
