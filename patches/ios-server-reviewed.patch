+// This gate uses the real Unity-built iOS profile in cloud builds. Local byte
+// fixtures above establish protocol behavior, not valid AssetBundle content.
+func TestIOSCompiledProfile(t *testing.T) {
+	profile := os.Getenv("IOS_COMPILED_PROFILE")
+	if profile == "" {
+		t.Skip("set IOS_COMPILED_PROFILE to a Unity-built iOS delivery profile")
+	}
+	delivery, err := loadPlatformDelivery(profile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if delivery.platform != "iOS" || delivery.unityVersion != "6000.3.26f1" {
+		t.Fatal("wrong build target")
+	}
+	router := chi.NewRouter()
+	registerPlatformContent(router, platformDeliveries{platformKey(delivery.platform, delivery.unityVersion): delivery}, nil, nil)
+	for name, file := range delivery.bundles {
+		payload, err := os.ReadFile(file.path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.HasPrefix(payload, []byte("UnityFS\x00")) || fmt.Sprintf("%x", sha256.Sum256(payload)) != file.sha {
+			t.Fatal("compiled bundle format/hash differs")
+		}
+		url := "/local/content/iOS/6000.3.26f1/" + delivery.contentID + "/patch/" + name + ".v" + file.crc
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, httptest.NewRequest(http.MethodGet, url, nil))
+		if w.Code != http.StatusOK || !bytes.Equal(w.Body.Bytes(), payload) {
+			t.Fatal("server did not deliver exact compiled iOS bytes")
+		}
+	}
+	if _, err := os.Stat(filepath.Join(filepath.Dir(profile), "resource-build.json")); err != nil {
+		t.Fatal("missing resource build evidence")
+	}
+}
+
+func TestIOSPublicManifestValidationAndDelivery(t *testing.T) {
+	for _, scenario := range []string{"valid", "wrong-platform", "wrong-version", "wrong-revision", "wrong-bundle-hash", "wrong-size", "duplicate"} {
+		t.Run(scenario, func(t *testing.T) {
+			profilePath := writePlatformFixture(t, t.TempDir(), "iOS", []byte("ios-only"))
+			encoded, err := os.ReadFile(profilePath)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var profile platformDeliveryProfile
+			if err := json.Unmarshal(encoded, &profile); err != nil {
+				t.Fatal(err)
+			}
+			file := profile.Bundles[0]
+			wire := platformClientManifest{Format: 1, Platform: "iOS", UnityVersion: profile.UnityVersion, ContentID: profile.ContentID, Bundles: []platformClientBundle{{Name: file.Name, File: file.SHA256 + ".bundle", Bytes: file.Bytes, SHA256: file.SHA256, CRC32: file.CRC32, Dependencies: []string{}}}}
+			wire.ContentID = iosClientManifestID(wire)
+			profile.ContentID = wire.ContentID
+			switch scenario {
+			case "wrong-platform":
+				wire.Platform = "Android"
+			case "wrong-version":
+				wire.UnityVersion = "5.3.5p1"
+			case "wrong-revision":
+				wire.ContentID = strings.Repeat("0", 64)
+			case "wrong-bundle-hash":
+				wire.Bundles[0].SHA256 = strings.Repeat("0", 64)
+			case "wrong-size":
+				wire.Bundles[0].Bytes++
+			case "duplicate":
+				wire.Bundles = append(wire.Bundles, wire.Bundles[0])
+			}
+			raw, err := json.Marshal(wire)
+			if err != nil {
+				t.Fatal(err)
+			}
+			digest := sha256.Sum256(raw)
+			profile.ClientManifest = &platformDeliveryCatalog{File: "client-manifest.json", Bytes: int64(len(raw)), SHA256: fmt.Sprintf("%x", digest)}
+			if err := os.WriteFile(filepath.Join(filepath.Dir(profilePath), "client-manifest.json"), raw, 0o600); err != nil {
+				t.Fatal(err)
+			}
+			encoded, err = json.Marshal(profile)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(profilePath, encoded, 0o600); err != nil {
+				t.Fatal(err)
+			}
+			delivery, err := loadPlatformDelivery(profilePath)
+			if scenario != "valid" {
+				if err == nil {
+					t.Fatal("inconsistent public manifest accepted")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			router := chi.NewRouter()
+			registerPlatformContent(router, platformDeliveries{platformKey("iOS", profile.UnityVersion): delivery}, nil, nil)
+			url := "/local/content/iOS/" + profile.UnityVersion + "/" + profile.ContentID + "/client-manifest.json"
+			w := httptest.NewRecorder()
+			router.ServeHTTP(w, httptest.NewRequest(http.MethodGet, url, nil))
+			if w.Code != http.StatusOK || !bytes.Equal(w.Body.Bytes(), raw) || w.Header().Get("Content-Type") != "application/json" {
+				t.Fatal("public manifest response differs")
+			}
+			w = httptest.NewRecorder()
+			router.ServeHTTP(w, httptest.NewRequest(http.MethodHead, url, nil))
+			if w.Code != http.StatusOK || w.Body.Len() != 0 {
+				t.Fatal("public manifest HEAD differs")
+			}
+		})
+	}
+}
