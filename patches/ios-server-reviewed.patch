+func TestIOSDeliveryLoginAndIsolation(t *testing.T) {
+	root := t.TempDir()
+	set, err := loadPlatformDeliveries([]string{
+		writePlatformFixture(t, root, "StandaloneWindows64", []byte("windows-only")),
+		writePlatformFixture(t, root, "Android", []byte("android-only")),
+		writePlatformFixture(t, root, "iOS", []byte("ios-only")),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	accounts := testfixture.NewFriendCapacityTestAccounts(t)
+	if err := accounts.AttachCreationPolicy(func() accountstore.CreationPolicy { return accountstore.CreationPolicy{DailyLimit: 10} }); err != nil {
+		t.Fatal(err)
+	}
+	router := chi.NewRouter()
+	router.Post("/local/client/login", platformClientLogin(accounts, "127.0.0.1", 26040, CDNConfig{}, "images", set))
+	registerPlatformContent(router, set, nil, nil)
+	var userID any
+	expected := map[string]string{"iOS": "ios-only", "StandaloneWindows64": "windows-only", "Android": "android-only"}
+	for _, platform := range []string{"iOS", "StandaloneWindows64", "Android", "iOS"} {
+		body, _ := json.Marshal(localLoginPayload{UUID: "a5750000-0000-4000-8000-000000000001", ClientVersion: cnMinimumClientVersion, ResourcePlatform: platform, UnityVersion: "6000.3.26f1"})
+		response := httptest.NewRecorder()
+		router.ServeHTTP(response, httptest.NewRequest(http.MethodPost, "/local/client/login", bytes.NewReader(body)))
+		var result map[string]any
+		if err := json.Unmarshal(response.Body.Bytes(), &result); err != nil || response.Code != http.StatusOK || result["res_code"] != float64(0) {
+			t.Fatal("target login failed", response.Code, err)
+		}
+		if userID != nil && userID != result["userid"] {
+			t.Fatal("changing platform created a second identity")
+		}
+		userID = result["userid"]
+		delivery := set[platformKey(platform, "6000.3.26f1")]
+		prefix := "/local/content/" + platform + "/6000.3.26f1/" + delivery.contentID
+		if result["version_url"] != "http://127.0.0.1:26040"+prefix+"/" {
+			t.Fatal("login selected wrong platform content")
+		}
+		file := delivery.bundles["main_c/menu.dat"]
+		url := prefix + "/patch/main_c/menu.dat.v" + file.crc
+		t.Run(platform+" delivery", func(t *testing.T) {
+			for _, method := range []string{http.MethodGet, http.MethodHead} {
+				w := httptest.NewRecorder()
+				router.ServeHTTP(w, httptest.NewRequest(method, url, nil))
+				if w.Code != http.StatusOK || w.Header().Get("ETag") != `"`+file.sha+`"` || w.Header().Get("Cache-Control") != "public, max-age=31536000, immutable" {
+					t.Fatal("incorrect immutable response", w.Code)
+				}
+				if method == http.MethodGet && w.Body.String() != expected[platform] {
+					t.Fatal("different platform bytes delivered")
+				}
+				if method == http.MethodHead && w.Body.Len() != 0 {
+					t.Fatal("HEAD had a body")
+				}
+			}
+			conditional := httptest.NewRequest(http.MethodGet, url, nil)
+			conditional.Header.Set("If-None-Match", `"`+file.sha+`"`)
+			w := httptest.NewRecorder()
+			router.ServeHTTP(w, conditional)
+			if w.Code != http.StatusNotModified {
+				t.Fatal("ETag not honored")
+			}
+			ranged := httptest.NewRequest(http.MethodGet, url, nil)
+			ranged.Header.Set("Range", "bytes=0-2")
+			w = httptest.NewRecorder()
+			router.ServeHTTP(w, ranged)
+			if w.Code != http.StatusPartialContent || w.Body.Len() != 3 {
+				t.Fatal("range failed")
+			}
+			for _, invalid := range []string{strings.Replace(url, "/6000.3.26f1/", "/5.3.5p1/", 1), strings.Replace(url, delivery.contentID, strings.Repeat("0", 64), 1), prefix + "/patch/undeclared.dat.v00000000"} {
+				w = httptest.NewRecorder()
+				router.ServeHTTP(w, httptest.NewRequest(http.MethodGet, invalid, nil))
+				if w.Code != http.StatusNotFound {
+					t.Fatal("undeclared content served", invalid, w.Code)
+				}
+			}
+		})
+	}
+	// No account store: missing iOS version must be rejected before account creation.
+	login := platformClientLogin(nil, "127.0.0.1", 26040, CDNConfig{}, "images", set)
+	for _, target := range []struct{ platform, unity string }{{"iOS", "5.3.5p1"}, {"ios", "6000.3.26f1"}, {"iOS", ""}} {
+		payload := fmt.Sprintf(`{"uuid":"a5750000-0000-4000-8000-000000000099","clver":"%s","resource_platform":"%s","unity_version":"%s"}`, cnMinimumClientVersion, target.platform, target.unity)
+		w := httptest.NewRecorder()
+		login(w, httptest.NewRequest(http.MethodPost, "/local/client/login", strings.NewReader(payload)))
+		if w.Code != http.StatusBadRequest {
+			t.Fatal("invalid target reached accounts")
+		}
+	}
+}
