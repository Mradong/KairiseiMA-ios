diff --git a/server/internal/cnbootstrap/platform_manifest.go b/server/internal/cnbootstrap/platform_manifest.go
new file mode 100644
--- /dev/null
+++ b/server/internal/cnbootstrap/platform_manifest.go
@@ -0,0 +1,76 @@
+package cnbootstrap
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+)
+
+type platformClientManifest struct {
+	Format       int                    `json:"format"`
+	Platform     string                 `json:"platform"`
+	UnityVersion string                 `json:"unityVersion"`
+	ContentID    string                 `json:"contentId"`
+	Bundles      []platformClientBundle `json:"bundles"`
+}
+
+type platformClientBundle struct {
+	Name         string   `json:"name"`
+	File         string   `json:"file"`
+	Bytes        int64    `json:"bytes"`
+	SHA256       string   `json:"sha256"`
+	CRC32        string   `json:"crc32"`
+	Dependencies []string `json:"dependencies"`
+}
+
+// The public manifest has no operator paths. It binds downloads to the exact
+// target, content revision and byte identities already registered by the server.
+func (delivery *platformDelivery) registerClientManifest(directory string, profile platformDeliveryProfile) error {
+	meta := profile.ClientManifest
+	if meta.Bytes <= 0 || meta.Bytes > 1<<20 || !contentHashValid(meta.SHA256) {
+		return errors.New("invalid public client manifest identity")
+	}
+	filename, err := platformRelativeFile(directory, meta.File)
+	if err != nil {
+		return err
+	}
+	info, err := os.Stat(filename)
+	if err != nil || !info.Mode().IsRegular() || info.Size() != meta.Bytes {
+		return errors.New("public client manifest size differs")
+	}
+	raw, err := os.ReadFile(filename)
+	if err != nil {
+		return err
+	}
+	digest := sha256.Sum256(raw)
+	if hex.EncodeToString(digest[:]) != meta.SHA256 {
+		return errors.New("public client manifest hash differs")
+	}
+	var wire platformClientManifest
+	if err := json.Unmarshal(raw, &wire); err != nil {
+		return err
+	}
+	if wire.Format != 1 || wire.Platform != delivery.platform || wire.UnityVersion != delivery.unityVersion || wire.ContentID != delivery.contentID || len(wire.Bundles) != len(delivery.bundles) {
+		return errors.New("public client manifest target or inventory differs")
+	}
+	seen := make(map[string]bool)
+	for _, row := range wire.Bundles {
+		file, exists := delivery.bundles[row.Name]
+		if !exists || seen[row.Name] || file.size != row.Bytes || file.sha != row.SHA256 || file.crc != row.CRC32 || row.File != row.SHA256+".bundle" {
+			return errors.New("public client manifest bundle differs")
+		}
+		seen[row.Name] = true
+		for _, dependency := range row.Dependencies {
+			if _, exists := delivery.bundles[dependency]; !exists || dependency == row.Name {
+				return errors.New("public client manifest dependency differs")
+			}
+		}
+	}
+	delivery.objects["client-manifest.json"] = platformContentObject{
+		file:       platformDeliveryFile{path: filename, size: meta.Bytes, sha: meta.SHA256},
+		sourceRoot: "delivery", root: directory, contentType: "application/json", data: raw,
+	}
+	return nil
+}
