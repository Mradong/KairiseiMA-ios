+// Call after account writers are drained. Commit the durable interruption
+// before evicting serving caches, so a failed write cannot resurrect or
+// silently discard a paid run. Inventory, balances and settled receipts keep
+// their existing owners.
+func (accounts *Accounts) DiscardUnsettledBattlesDurably() (int, error) {
+	accounts.battleMu.Lock()
+	defer accounts.battleMu.Unlock()
+	database, err := accounts.storage.Open()
+	if err != nil {
+		return 0, err
+	}
+	transaction, err := database.BeginTx(context.Background(), nil)
+	if err != nil {
+		return 0, err
+	}
+	defer transaction.Rollback()
+	type pending struct {
+		userID  int
+		table   string
+		content []byte
+	}
+	rows, err := transaction.Query(`SELECT ?, 'cn_save_snapshot', payload_json FROM cn_save_snapshot
+		WHERE singleton=1 AND json_type(CAST(payload_json AS TEXT),'$.active_solo_battle') IS NOT NULL
+		UNION ALL SELECT user_id, 'cn_account_snapshot', payload_json FROM cn_account_snapshot
+		WHERE json_type(CAST(payload_json AS TEXT),'$.active_solo_battle') IS NOT NULL`, PrimaryUserID)
+	if err != nil {
+		return 0, err
+	}
+	var saved []pending
+	for rows.Next() {
+		var row pending
+		if err := rows.Scan(&row.userID, &row.table, &row.content); err != nil {
+			rows.Close()
+			return 0, err
+		}
+		saved = append(saved, row)
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return 0, err
+	}
+	removed := make(map[int]bool, len(accounts.battles)+len(saved))
+	for userID := range accounts.battles {
+		removed[userID] = true
+	}
+	updated := time.Now().UTC().Format(time.RFC3339Nano)
+	for _, row := range saved {
+		var fields map[string]json.RawMessage
+		if err := json.Unmarshal(row.content, &fields); err != nil {
+			return 0, err
+		}
+		delete(fields, "active_solo_battle")
+		delete(fields, "active_solo_battle_expires_unix")
+		content, err := json.Marshal(fields)
+		if err != nil {
+			return 0, err
+		}
+		digest := sha256.Sum256(content)
+		query, key := `UPDATE cn_account_snapshot SET payload_json=?,payload_sha256=?,revision=revision+1,updated_utc=? WHERE user_id=?`, row.userID
+		if row.table == "cn_save_snapshot" {
+			query, key = `UPDATE cn_save_snapshot SET payload_json=?,payload_sha256=?,revision=revision+1,updated_utc=? WHERE singleton=?`, 1
+		}
+		result, err := transaction.Exec(query, content, hex.EncodeToString(digest[:]), updated, key)
+		if err != nil {
+			return 0, err
+		}
+		if affected, err := result.RowsAffected(); err != nil || affected != 1 {
+			return 0, errors.New("durable solo interruption did not update one account snapshot")
+		}
+		state, err := accounts.storage.decodeAccount(transaction, content)
+		if err != nil {
+			return 0, err
+		}
+		var revision int
+		revisionQuery := `SELECT revision FROM cn_account_snapshot WHERE user_id=?`
+		if row.table == "cn_save_snapshot" {
+			revisionQuery = `SELECT revision FROM cn_save_snapshot WHERE singleton=?`
+		}
+		if err := transaction.QueryRow(revisionQuery, key).Scan(&revision); err != nil {
+			return 0, err
+		}
+		var ownerExists int
+		if err := transaction.QueryRow(`SELECT COUNT(*) FROM cn_local_account WHERE user_id=?`, row.userID).Scan(&ownerExists); err != nil {
+			return 0, err
+		}
+		if ownerExists == 1 {
+			if err := upsertAccountProjection(transaction, row.userID, revision, updated, state); err != nil {
+				return 0, err
+			}
+		}
+		removed[row.userID] = true
+	}
+	if err := transaction.Commit(); err != nil {
+		return 0, err
+	}
+	for _, session := range accounts.battles {
+		session.timer.Stop()
+	}
+	clear(accounts.battles)
+	return len(removed), nil
+}
